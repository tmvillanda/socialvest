<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_xlarge">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Socialvest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/learn_caption"
                    android:textAppearance="@style/TextAppearance.Socialvest.SectionTitle"
                    android:textColor="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/text_source_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="@style/TextAppearance.Socialvest.Caption"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="36 video dari kanal Saham dari Nol. Video diputar langsung dari YouTube; aplikasi tidak mengunduh materi." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_playlist"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/learn_source_open"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    app:icon="@drawable/ic_play_circle"
                    app:iconTint="?attr/colorOnSecondaryContainer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_course_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textAppearance="@style/TextAppearance.Socialvest.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3 kursus" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_course" />

        <LinearLayout
            android:id="@+id/group_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_large"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:contentDescription="@string/content_desc_module_icon"
                android:src="@drawable/ic_learn"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/learn_empty_title"
                android:textAppearance="@style/TextAppearance.Socialvest.SectionTitle"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/learn_empty_message"
                android:textAppearance="@style/TextAppearance.Socialvest.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textAppearance="@style/TextAppearance.Socialvest.Body"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Gagal memuat kursus."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_retry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/learn_error_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_learn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_medium"
            android:indeterminate="true"
            app:indicatorSize="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:lineSpacingExtra="3dp"
            android:text="@string/learn_disclaimer"
            android:textAppearance="@style/TextAppearance.Socialvest.Caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
